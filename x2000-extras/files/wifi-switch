#!/bin/sh
# Turn Wi-Fi on or off as a whole, like the hardware Wi-Fi switch on other
# GL.iNet routers. Bound to the reset button (hold 2-5s), e.g. to run the box
# as a plain modem/uplink for another router and bring Wi-Fi back when it is
# used on its own.
#
# The radios and SSIDs (wifi-device and wifi-iface sections) that were enabled
# when switching off are remembered and re-enabled when switching on, so one
# you turned off on purpose stays off. A fresh install starts with Wi-Fi on.
#
# NO_RELOAD=1 only changes the config, for use before wifi is up (uci-defaults).

STATE=/etc/wifi-switch
RADIOS=/etc/wifi-switch.radios
LED=/sys/class/leds/green:power

. /lib/functions.sh

any_enabled() {
	local disabled
	config_get disabled "$1" disabled 0
	[ "$disabled" = 1 ] || found=1
}

current() {
	[ -s "$STATE" ] && { cat "$STATE"; return; }
	# first run: infer from the radios
	found=0
	config_load wireless
	config_foreach any_enabled wifi-device
	[ "$found" = 1 ] && echo on || echo off
}

led_busy() {
	echo timer > "$LED/trigger" 2>/dev/null
	echo 100 > "$LED/delay_on" 2>/dev/null
	echo 100 > "$LED/delay_off" 2>/dev/null
}

led_done() {
	echo default-on > "$LED/trigger" 2>/dev/null
}

save_radio() {
	local disabled
	config_get disabled "$1" disabled 0
	[ "$disabled" = 1 ] || echo "$1" >> "$RADIOS"
}

all_radios() {
	local encryption
	# never bring up an open SSID by accident
	config_get encryption "$1" encryption none
	[ "$2" = wifi-iface ] && [ "$encryption" = none ] && return 0
	echo "$1" >> "$RADIOS"
}

switch_off() {
	: > "$RADIOS"
	config_load wireless
	config_foreach save_radio wifi-device
	config_foreach save_radio wifi-iface
	while read -r r; do
		uci set wireless."$r".disabled=1
	done < "$RADIOS"
	uci commit wireless
	[ -n "$NO_RELOAD" ] || wifi
}

switch_on() {
	# never switched off (or the list was lost): bring up every radio
	if [ ! -s "$RADIOS" ]; then
		config_load wireless
		config_foreach all_radios wifi-device wifi-device
		config_foreach all_radios wifi-iface wifi-iface
	fi
	while read -r r; do
		uci set wireless."$r".disabled=0
	done < "$RADIOS"
	uci commit wireless
	rm -f "$RADIOS"
	[ -n "$NO_RELOAD" ] || wifi
}

apply() {
	if [ "$1" = "$(current)" ]; then
		echo "$1" > "$STATE"
		echo "wifi already $1"
		return 0
	fi
	logger -t wifi-switch "switching wifi $1"
	[ -n "$NO_RELOAD" ] || led_busy
	case "$1" in
		on)  switch_on ;;
		off) switch_off ;;
	esac
	echo "$1" > "$STATE"
	[ -n "$NO_RELOAD" ] || led_done
	echo "wifi $1"
}

case "$1" in
	on|off) apply "$1" ;;
	toggle)
		[ "$(current)" = off ] && apply on || apply off
		;;
	status|'') current ;;
	*)
		echo "usage: $0 on|off|toggle|status" >&2
		exit 1
		;;
esac
