#!/bin/sh /etc/rc.common
# Drives the LEDs that have no kernel trigger: the "Internet" LED (from real
# connectivity, whatever the uplink) and the four cellular signal bars.

USE_PROCD=1
START=99

INTERVAL=10

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh -c \
		"while :; do /usr/sbin/internet-led; /usr/sbin/cellular-leds; sleep $INTERVAL; done"
	procd_set_param respawn
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# leave the LEDs in a defined state rather than frozen
	for i in 1 2 3 4; do
		echo 0 > "/sys/class/leds/green:indicator-$i/brightness" 2>/dev/null
	done
}
